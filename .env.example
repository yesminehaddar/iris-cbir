DATABASE_URL=postgresql://cbir:cbir@localhost:5432/cbir

# The 1M-image thumbnail base, described with MPEG-7 descriptors. This is the
# base the server serves. Relative paths resolve against the cbir/ directory.
FLICKR_DIR=../thumbnails
FLICKR_FEATURES_DIR=data/features/flickr1m

# The synthetic "objects" base is not served; it exists only so that
# scripts/evaluate.py can be rerun on a base that has class labels. These are
# the defaults, so both lines can stay commented out.
#OBJECTS_DIR=data/objects
#OBJECTS_FEATURES_DIR=data/features/objects
